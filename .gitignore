__pycache__/
*.py[cod]
*$py.class
*.DS_Store
*.egg-info/
.pytest_cache/
.certs/

# ---------------------------------------------------------------------------
# Working caches: regenerable, version-fragile, or huge. NOT the record.
# The durable record of all of this lives in archive/ as Parquet + JSON,
# built and fidelity-checked by scripts/build_archive.py.
# ---------------------------------------------------------------------------
/data/
/services/predictor/data/
# pickle is a cache, never an archive -- it is version-fragile
*.pkl
*.nc
# 8,219 per-window MCMC pickles -> archive/predictions.parquet
work_products/*/checkpoints/
# logs are never worth tracking, at any depth
*.log
work_products/.sweep_status/
work_products/wp014_npxg_decomposition/shots/
work_products/wp011_squad_instability/rosters/
# 11MB CSV, archived as archive/raw/elo_ratings.parquet (0.8MB)
work_products/wp025_elo_channel/elo_ratings.csv

# ---------------------------------------------------------------------------
# The archive IS tracked. Parquet is columnar, compressed and stable across
# library versions; the scraped JSON is text and diffable. 105.8MB of pickles
# compress to 23.9MB here, so the expensive-to-recreate artefacts fit in git:
#   * 8,219 MCMC checkpoints  = 150+ hours of sampling
#   * Transfermarkt scrapes   = ~2,700 requests against a third party that can
#                               restructure or block at any time (unrecoverable)
# ---------------------------------------------------------------------------
!archive/
!archive/**

# machine-local Claude Code settings (settings.json is the shared one)
.claude/settings.local.json
